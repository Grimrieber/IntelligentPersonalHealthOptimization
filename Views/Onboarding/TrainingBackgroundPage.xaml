<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             xmlns:enums="clr-namespace:IntelligentPersonalHealthOptimization.Models.Enums"
             xmlns:controls="clr-namespace:IntelligentPersonalHealthOptimization.Controls"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.TrainingBackgroundPage"
             x:DataType="vm:TrainingBackgroundViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Training Background"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Tell us about your training experience and preferences so we can match your program level."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Training Location -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Training Location" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Where do you primarily train? This will suggest relevant equipment."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Picker Title="Select Location"
                                    ItemsSource="{Binding TrainingLocationOptions}"
                                    SelectedItem="{Binding SelectedTrainingLocation}" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- Experience Level -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Experience Level" FontSize="16" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Picker Title="Select Level"
                                    ItemsSource="{Binding ExperienceLevels}"
                                    SelectedItem="{Binding SelectedExperienceLevel}" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- Frequency -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Current Training Frequency" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="-"
                                    Command="{Binding DecrementFrequencyCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="0" />
                            <Label Text="{Binding FrequencyDisplay}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                            <Button Text="+"
                                    Command="{Binding IncrementFrequencyCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Session Duration -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Session Duration" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="-"
                                    Command="{Binding DecrementDurationCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="0" />
                            <Label Text="{Binding DurationDisplay}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                            <Button Text="+"
                                    Command="{Binding IncrementDurationCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Equipment -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Available Equipment" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Select all equipment you have access to."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <FlexLayout Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding SelectedEquipment}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="enums:EquipmentType">
                                    <Border StrokeShape="RoundRectangle 16"
                                            Stroke="{StaticResource Primary}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                                            Padding="12,6"
                                            Margin="4">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding .}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label Text="x"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{StaticResource Gray500}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainingBackgroundViewModel}}, Path=RemoveEquipmentCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Button Text="+ Add Equipment"
                                Command="{Binding ToggleEquipmentCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="14"
                                HeightRequest="40" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Training Days (tap to select — sets both which days and how many per week) -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Available Training Days" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Tap the days you can train. This sets both which days we schedule and how many days per week."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                        <controls:TrainingDaySelector SelectedDaysCsv="{Binding AvailableDaysCsv}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Preferred Time -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Preferred Training Time" FontSize="16" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Picker Title="Select Time"
                                    ItemsSource="{Binding TimeOfDayOptions}"
                                    SelectedItem="{Binding SelectedTimeOfDay}" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
