<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             xmlns:enums="clr-namespace:IntelligentPersonalHealthOptimization.Models.Enums"
             xmlns:models="clr-namespace:IntelligentPersonalHealthOptimization.Models"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.NutritionSetupPage"
             x:DataType="vm:NutritionSetupViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Nutrition Setup"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Your dietary preferences help us create a personalized nutrition plan alongside your workout program."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Diet Type -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Diet Type" FontSize="16" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Picker Title="Select Diet"
                                    ItemsSource="{Binding DietTypeOptions}"
                                    SelectedItem="{Binding SelectedDietType}" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- Meals Per Day -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Meals Per Day" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="-"
                                    Command="{Binding DecrementMealsCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="0" />
                            <Label Text="{Binding MealsPerDayDisplay}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                            <Button Text="+"
                                    Command="{Binding IncrementMealsCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Food Allergies -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Food Allergies" FontSize="16" FontAttributes="Bold" />

                        <Label Text="Tap any that apply." FontSize="13" TextColor="{StaticResource Gray500}" />
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding AllergyChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ToggleChip">
                                    <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource Primary}" StrokeThickness="1"
                                            BackgroundColor="Transparent" Padding="14,9" Margin="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionSetupViewModel}}, Path=ToggleAllergyChipCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Label}" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daily Water -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Water Intake" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="-"
                                    Command="{Binding DecrementWaterCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="0" />
                            <Label Text="{Binding WaterDisplay}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                            <Button Text="+"
                                    Command="{Binding IncrementWaterCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    CornerRadius="22"
                                    Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Nutrition Assessment Summary -->
                <Frame Style="{StaticResource CardFrame}"
                       IsVisible="{Binding HasSummaryData}"
                       BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Your Nutrition Profile"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                        <Label Text="Based on your body metrics, activity level, and fitness goals:"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Basal Metabolic Rate (BMR)"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <Label Text="{Binding BMRDisplay}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total Daily Energy (TDEE)"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <Label Text="{Binding TDEEDisplay}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Recommended Daily Calories"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />
                            <Label Text="{Binding CaloriesDisplay}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />
                        </Grid>

                        <Label Text="Macro Targets" FontSize="14" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                <Label Text="{Binding RecommendedProteinG, StringFormat='{0}g'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="Protein"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="{Binding RecommendedCarbsG, StringFormat='{0}g'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="Carbs"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="{Binding RecommendedFatG, StringFormat='{0}g'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="Fat"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="These values are calculated from your profile. To adjust them, update your body metrics, activity level, or fitness goal in earlier steps."
                               FontSize="11"
                               TextColor="{StaticResource Gray500}"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
