<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.ReviewPage"
             x:DataType="vm:ReviewViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,8">

                <Label Text="Review &amp; Finish"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Review your information below. You can go back to change anything before creating your account."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Personal Info -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Personal Info" FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,2" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="Name:" FontAttributes="Bold" FontSize="13" Grid.Row="0" Grid.Column="0" />
                            <Label Text="{Binding FullName}" FontSize="13" Grid.Row="0" Grid.Column="1" />
                            <Label Text="DOB:" FontAttributes="Bold" FontSize="13" Grid.Row="1" Grid.Column="0" />
                            <Label Text="{Binding DateOfBirthDisplay}" FontSize="13" Grid.Row="1" Grid.Column="1" />
                            <Label Text="Gender:" FontAttributes="Bold" FontSize="13" Grid.Row="2" Grid.Column="0" />
                            <Label Text="{Binding GenderDisplay}" FontSize="13" Grid.Row="2" Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Body Metrics -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Body Metrics" FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,2" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="Height:" FontAttributes="Bold" FontSize="13" Grid.Row="0" Grid.Column="0" />
                            <Label Text="{Binding HeightDisplay}" FontSize="13" Grid.Row="0" Grid.Column="1" />
                            <Label Text="Weight:" FontAttributes="Bold" FontSize="13" Grid.Row="1" Grid.Column="0" />
                            <Label Text="{Binding WeightDisplay}" FontSize="13" Grid.Row="1" Grid.Column="1" />
                            <Label Text="BMI:" FontAttributes="Bold" FontSize="13" Grid.Row="2" Grid.Column="0" />
                            <Label Text="{Binding BmiDisplay}" FontSize="13" Grid.Row="2" Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Health Screening -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Health Screening" FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,2" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Text="Conditions:" FontAttributes="Bold" FontSize="13" Grid.Row="0" Grid.Column="0" />
                            <Label Text="{Binding ConditionsDisplay}" FontSize="13" Grid.Row="0" Grid.Column="1" />
                            <Label Text="Injuries:" FontAttributes="Bold" FontSize="13" Grid.Row="1" Grid.Column="0" />
                            <Label Text="{Binding InjuriesDisplay}" FontSize="13" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Disclaimer -->
                <Frame Style="{StaticResource CardFrame}"
                       BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E2723}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Medical Disclaimer"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#F57F17, Dark=#FFCC80}" />
                        <Label Text="{Binding DisclaimerText}"
                               FontSize="12"
                               LineHeight="1.4"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasAcceptedDisclaimer}" />
                            <Label Text="I have read and accept the disclaimer"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmptyConverter}}" />

                <!-- Status Message -->
                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding IsCreating}"
                                     HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsCreating}"
                                       HorizontalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    IsEnabled="{Binding IsCreating, Converter={StaticResource InverseBool}}"
                    Grid.Column="0" />
            <Button Text="Get Started"
                    Command="{Binding CreatePlanCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanCreate}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
