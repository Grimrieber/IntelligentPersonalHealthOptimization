<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.MovementAssessmentPage"
             x:DataType="vm:MovementAssessmentViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Movement Assessment"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Check any compensations or deviations you observe. Be honest -- this helps us build a safer, more effective program."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Section A: Posture Self-Check -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="A. Posture Self-Check"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Stand naturally in front of a mirror. Check any deviations you notice."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout Spacing="4"
                                             BindableLayout.ItemsSource="{Binding PostureItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PostureCheckItem">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            Padding="12,8"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalOptions="Start"
                                                      Grid.Column="0" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray500}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section B: Overhead Squat -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="B. Overhead Squat Assessment"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Stand with feet shoulder-width apart, arms overhead. Perform 5 slow squats. Check any compensations observed."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout Spacing="4"
                                             BindableLayout.ItemsSource="{Binding OverheadSquatItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompensationCheckItem">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            Padding="12,8"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalOptions="Center"
                                                      Grid.Column="0" />
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   Grid.Column="1" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section C: Single-Leg Balance Left -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="C. Single-Leg Balance - Left Leg"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Stand on your LEFT leg for 20 seconds with eyes open. Check any compensations observed."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout Spacing="4"
                                             BindableLayout.ItemsSource="{Binding SingleLegLeftItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompensationCheckItem">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            Padding="12,8"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalOptions="Center"
                                                      Grid.Column="0" />
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   Grid.Column="1" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Section D: Single-Leg Balance Right -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="D. Single-Leg Balance - Right Leg"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Stand on your RIGHT leg for 20 seconds with eyes open. Check any compensations observed."
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout Spacing="4"
                                             BindableLayout.ItemsSource="{Binding SingleLegRightItems}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompensationCheckItem">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            Padding="12,8"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalOptions="Center"
                                                      Grid.Column="0" />
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   Grid.Column="1" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
