<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.FitnessBenchmarkPage"
             x:DataType="vm:FitnessBenchmarkViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Fitness Benchmarks"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="These quick tests help us gauge your current fitness level. Do your best but stop if you feel pain."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Push-ups -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Push-Up Test" FontSize="16" FontAttributes="Bold" />
                        <Label Text="How many push-ups can you do in 60 seconds?"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Entry Text="{Binding PushUpText}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   ReturnType="Next" />
                        </Border>
                        <Label FontSize="13" TextColor="{StaticResource Gray500}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Rating: " />
                                    <Span Text="{Binding PushUpRating}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Plank -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Plank Hold Test" FontSize="16" FontAttributes="Bold" />
                        <Label Text="How long can you hold a plank? (seconds)"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Entry Text="{Binding PlankText}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   ReturnType="Next" />
                        </Border>
                        <Label FontSize="13" TextColor="{StaticResource Gray500}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Rating: " />
                                    <Span Text="{Binding PlankRating}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Squats -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Bodyweight Squat Test" FontSize="16" FontAttributes="Bold" />
                        <Label Text="How many bodyweight squats can you do in 60 seconds?"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Entry Text="{Binding SquatText}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   ReturnType="Done" />
                        </Border>
                        <Label FontSize="13" TextColor="{StaticResource Gray500}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Rating: " />
                                    <Span Text="{Binding SquatRating}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cardio -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Cardio Talk Test" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Walk briskly for 3 minutes. How was your breathing?"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Picker Title="Select Result"
                                    ItemsSource="{Binding CardioOptions}"
                                    SelectedItem="{Binding SelectedCardioResult}" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- Overall Fitness Level -->
                <Frame Style="{StaticResource CardFrame}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Overall Fitness Level"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding OverallFitnessLevel}"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
