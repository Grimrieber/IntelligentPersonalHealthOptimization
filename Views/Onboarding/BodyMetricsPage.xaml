<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.BodyMetricsPage"
             x:DataType="vm:BodyMetricsViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" Padding="0,8">

                <Label Text="Body Metrics"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Your height and weight help us calculate your BMI, caloric needs, and tailor exercise selections."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Height Section -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Height" FontSize="16" FontAttributes="Bold" />
                        <Label Text="{Binding HeightDisplay}"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Slider Minimum="100"
                                Maximum="220"
                                Value="{Binding HeightCm}" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="100 cm / 3'3&quot;" FontSize="11" TextColor="{StaticResource Gray400}" Grid.Column="0" />
                            <Label Text="220 cm / 7'3&quot;" FontSize="11" TextColor="{StaticResource Gray400}" Grid.Column="1" HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Weight Section -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Weight" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" HorizontalOptions="Center">
                            <VerticalStackLayout Spacing="2" Grid.Column="0" HorizontalOptions="Center">
                                <Label Text="{Binding WeightKg, StringFormat='{0:F1}'}"
                                       FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="kg" FontSize="13" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="{Binding WeightLbDisplay}"
                                       FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="lb" FontSize="13" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <Slider Minimum="30"
                                Maximum="200"
                                Value="{Binding WeightKg}" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="30 kg / 66 lb" FontSize="11" TextColor="{StaticResource Gray400}" Grid.Column="0" />
                            <Label Text="200 kg / 440 lb" FontSize="11" TextColor="{StaticResource Gray400}" Grid.Column="1" HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- BMI Display -->
                <Frame Style="{StaticResource CardFrame}">
                    <Label Text="{Binding BmiDisplay}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
