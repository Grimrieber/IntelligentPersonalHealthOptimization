<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.Onboarding"
             x:Class="IntelligentPersonalHealthOptimization.Views.Onboarding.PersonalInfoPage"
             x:DataType="vm:PersonalInfoViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Tell Us About Yourself"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="We'll use this information to personalize your experience."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- First Name -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="First Name" FontSize="13" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            Padding="12,4">
                        <Entry Text="{Binding FirstName}"
                               Placeholder="Enter your first name"
                               ReturnType="Next" />
                    </Border>
                </VerticalStackLayout>

                <!-- Last Name -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Last Name" FontSize="13" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            Padding="12,4">
                        <Entry Text="{Binding LastName}"
                               Placeholder="Enter your last name"
                               ReturnType="Next" />
                    </Border>
                </VerticalStackLayout>

                <!-- Date of Birth -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Date of Birth" FontSize="13" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto,*,Auto,1.4*" ColumnSpacing="4">
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="8,4" Grid.Column="0">
                            <Entry Text="{Binding BirthMonth}"
                                   Placeholder="MM"
                                   Keyboard="Numeric"
                                   MaxLength="2"
                                   HorizontalTextAlignment="Center"
                                   ReturnType="Next" />
                        </Border>
                        <Label Text="/" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="1" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="8,4" Grid.Column="2">
                            <Entry Text="{Binding BirthDay}"
                                   Placeholder="DD"
                                   Keyboard="Numeric"
                                   MaxLength="2"
                                   HorizontalTextAlignment="Center"
                                   ReturnType="Next" />
                        </Border>
                        <Label Text="/" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center" Grid.Column="3" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="8,4" Grid.Column="4">
                            <Entry Text="{Binding BirthYear}"
                                   Placeholder="YYYY"
                                   Keyboard="Numeric"
                                   MaxLength="4"
                                   HorizontalTextAlignment="Center"
                                   ReturnType="Next" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding DateOfBirthError}"
                           FontSize="12"
                           TextColor="Red"
                           IsVisible="{Binding HasDateOfBirthError}" />
                </VerticalStackLayout>

                <!-- Gender -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Biological Sex" FontSize="13" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            Padding="12,4">
                        <Picker Title="Select Biological Sex"
                                ItemsSource="{Binding GenderOptions}"
                                SelectedItem="{Binding SelectedGender}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Validation Message -->
                <Label Text="{Binding ValidationMessage}"
                       TextColor="Red"
                       FontSize="13"
                       IsVisible="{Binding ValidationMessage, Converter={StaticResource IsNotEmptyConverter}}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
