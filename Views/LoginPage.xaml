<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             x:Class="IntelligentPersonalHealthOptimization.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*, Auto, *" Padding="32">

        <!-- Logo and Title -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Spacing="8" Margin="0,0,0,32">
            <Label Text="&#x1F3CB;"
                   FontSize="64"
                   HorizontalOptions="Center" />
            <Label Text="Health Optimizer"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
            <Label Text="Your personal health companion"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <!-- Login / Reset PIN -->
        <VerticalStackLayout Grid.Row="1" Spacing="16">

            <!-- Normal login view -->
            <VerticalStackLayout Spacing="16"
                                 IsVisible="{Binding IsResettingPin, Converter={StaticResource InverseBool}}">
                <Entry Placeholder="Enter PIN"
                       Text="{Binding Pin}"
                       Keyboard="Numeric"
                       IsPassword="True"
                       MaxLength="6"
                       HorizontalOptions="Center"
                       WidthRequest="200"
                       HorizontalTextAlignment="Center"
                       FontSize="24"
                       ReturnType="Go"
                       ReturnCommand="{Binding LoginCommand}" />

                <Button Text="Unlock"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        HorizontalOptions="Center"
                        WidthRequest="200" />

                <Button Text="Use Biometrics"
                        Command="{Binding BiometricLoginCommand}"
                        IsVisible="{Binding IsBiometricAvailable}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        HorizontalOptions="Center" />

                <Button Text="Forgot PIN?"
                        Command="{Binding ForgotPinCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray500}"
                        FontSize="14"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Reset PIN view -->
            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding IsResettingPin}">

                <Label Text="Reset Your PIN"
                       FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="{Binding SecurityQuestion}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Primary}" />

                <Entry Placeholder="Your answer"
                       Text="{Binding SecurityAnswer}"
                       HorizontalOptions="Center"
                       WidthRequest="250"
                       HorizontalTextAlignment="Center"
                       ReturnType="Next" />

                <Entry Placeholder="New PIN (4-6 digits)"
                       Text="{Binding NewPin}"
                       Keyboard="Numeric"
                       IsPassword="True"
                       MaxLength="6"
                       HorizontalOptions="Center"
                       WidthRequest="200"
                       HorizontalTextAlignment="Center"
                       FontSize="20"
                       ReturnType="Next" />

                <Entry Placeholder="Confirm new PIN"
                       Text="{Binding ConfirmNewPin}"
                       Keyboard="Numeric"
                       IsPassword="True"
                       MaxLength="6"
                       HorizontalOptions="Center"
                       WidthRequest="200"
                       HorizontalTextAlignment="Center"
                       FontSize="20"
                       ReturnType="Done" />

                <Button Text="Reset PIN"
                        Command="{Binding ResetPinCommand}"
                        HorizontalOptions="Center"
                        WidthRequest="200" />

                <Button Text="Cancel"
                        Command="{Binding CancelResetCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray500}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Shared error/loading -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
