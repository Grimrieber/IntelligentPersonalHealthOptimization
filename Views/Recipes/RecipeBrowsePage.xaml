<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             xmlns:recipe="clr-namespace:IntelligentPersonalHealthOptimization.Models.Recipe"
             xmlns:models="clr-namespace:IntelligentPersonalHealthOptimization.Models"
             x:Class="IntelligentPersonalHealthOptimization.Views.Recipes.RecipeBrowsePage"
             x:DataType="vm:RecipeBrowseViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <!-- Toggleable macro/diet filter chip. Purple fill when selected. -->
        <DataTemplate x:Key="FilterChipTemplate" x:DataType="vm:FilterChip">
            <Border Padding="12,6" Margin="0,0,8,8" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=ToggleChipCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding Label}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Top Bar: Search + Back + Saved Toggle -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,8" Spacing="10">

            <!-- Search + Favorites on one row: search fills, Favorites toggle on the
                 right (becomes "Browse All" in favorites). No standalone Browse button. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <SearchBar Grid.Column="0"
                           Placeholder="Search recipes or ingredients..."
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}"
                           VerticalOptions="Center"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
                <Button Grid.Column="1"
                        Text="{Binding SavedToggleText}"
                        Command="{Binding ToggleSavedViewCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="44"
                        CornerRadius="22"
                        Padding="18,0"
                        FontSize="14"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Drill-up back button (only when inside a group / recipe list) -->
            <Button Text="{Binding BackLabel}"
                    Command="{Binding BackToCategoriesCommand}"
                    IsVisible="{Binding CanGoBack}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="14"
                    Padding="0"
                    HorizontalOptions="Start" />

            <!-- Filter bar (recipe list only): Healthy toggle + expandable macro/diet filters. -->
            <VerticalStackLayout IsVisible="{Binding IsShowingRecipeList}" Spacing="10" Padding="2,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label VerticalOptions="Center" FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="&#x1F957; " />
                                    <Span Text="Healthy only" FontAttributes="Bold"
                                          TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Switch IsToggled="{Binding ShowHealthyOnly}"
                                OnColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="1"
                            Text="{Binding FilterButtonText}"
                            Command="{Binding ToggleFiltersCommand}"
                            FontSize="13" HeightRequest="38" Padding="14,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Expandable filter panel -->
                <Border IsVisible="{Binding ShowFilters}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <!-- Sort -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="Sort" FontAttributes="Bold" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SelectedSort}"
                                    FontSize="14" />
                        </Grid>

                        <!-- Macro quick-filters -->
                        <Label Text="MACROS" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}" />
                        <FlexLayout Wrap="Wrap" Direction="Row"
                                    BindableLayout.ItemsSource="{Binding MacroChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <!-- Diet -->
                        <Label Text="DIET" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}" />
                        <FlexLayout Wrap="Wrap" Direction="Row"
                                    BindableLayout.ItemsSource="{Binding DietChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Button Text="Clear filters"
                                Command="{Binding ClearFiltersCommand}"
                                IsVisible="{Binding HasActiveFilters}"
                                FontSize="13" HeightRequest="36"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                HorizontalOptions="Start" Padding="0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Connection warning -->
            <Label Text="{Binding ConnectionStatus}"
                   IsVisible="{Binding IsConnected, Converter={StaticResource InverseBool}}"
                   TextColor="Red"
                   FontSize="13"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Top-level Groups Grid -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Groups}"
                        IsVisible="{Binding IsShowingGroups}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <BoxView HeightRequest="4" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="recipe:RecipeCategory">
                    <Frame Style="{StaticResource CardFrame}"
                           Margin="8,0"
                           Padding="10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=SelectGroupCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="46" HeightRequest="46"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding Accent}"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Emoji}"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding CategoryName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="{Binding RecipeCount, StringFormat='{0} recipes'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Categories Grid (within a selected group) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categories}"
                        IsVisible="{Binding IsShowingCategories}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Header>
                <BoxView HeightRequest="4" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="recipe:RecipeCategory">
                    <Frame Style="{StaticResource CardFrame}"
                           Margin="8,0"
                           Padding="10">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=SelectCategoryCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="46" HeightRequest="46"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding Accent}"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Emoji}"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding CategoryName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="{Binding RecipeCount, StringFormat='{0} recipes'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Recipe List (browse mode) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Recipes}"
                        IsVisible="{Binding IsShowingRecipeList}"
                        SelectionMode="None">
            <CollectionView.Header>
                <BoxView HeightRequest="4" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="recipe:RecipeItem">
                    <Frame Style="{StaticResource CardFrame}" Margin="16,4" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=ViewRecipeCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                            <!-- Thumbnail: emoji tile always sits behind as a placeholder;
                                 the photo draws on top once it loads (shows through while
                                 loading or if there's no photo). Explicit sizes + no
                                 IsVisible toggle avoid deferred list-image loading. -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                    WidthRequest="60" HeightRequest="60"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Grid WidthRequest="60" HeightRequest="60">
                                    <Border StrokeThickness="0" BackgroundColor="{Binding Accent}">
                                        <Label Text="{Binding Emoji}" FontSize="26"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                                           WidthRequest="60" HeightRequest="60" />
                                </Grid>
                            </Border>

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding RecipeName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            <!-- Prep/Cook — wrap (FlexLayout) so long/messy time strings
                                 don't clip at the right edge. -->
                            <FlexLayout Grid.Row="1" Grid.Column="1" Wrap="Wrap" Direction="Row">
                                <Label IsVisible="{Binding PrepTime, Converter={StaticResource IsNotEmptyConverter}}"
                                       FontSize="12" Margin="0,0,12,0" LineBreakMode="WordWrap">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Prep: " TextColor="{StaticResource Gray500}" />
                                            <Span Text="{Binding PrepTime}" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label IsVisible="{Binding CookTime, Converter={StaticResource IsNotEmptyConverter}}"
                                       FontSize="12" LineBreakMode="WordWrap">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Cook: " TextColor="{StaticResource Gray500}" />
                                            <Span Text="{Binding CookTime}" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </FlexLayout>
                            <FlexLayout Grid.Row="2" Grid.Column="1" Wrap="Wrap" AlignItems="Center">
                                <!-- Health tier chip (green Healthy / amber Moderate /
                                     clay Indulgent; "Treat" = a lean sweet). -->
                                <Border IsVisible="{Binding ShowHealthBadge}"
                                        BackgroundColor="{Binding HealthBadgeColor}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                        Padding="7,2" Margin="0,0,8,2">
                                    <Label Text="{Binding HealthBadgeText}"
                                           FontSize="10" FontAttributes="Bold" TextColor="White" />
                                </Border>
                                <Label Text="{Binding Servings, StringFormat='Serves {0}'}"
                                       IsVisible="{Binding Servings, Converter={StaticResource IsNotEmptyConverter}}"
                                       FontSize="12" TextColor="{StaticResource Gray500}" Margin="0,0,12,0" />
                                <Label Text="{Binding CaloriesPerServing, StringFormat='{0} cal/serving'}"
                                       IsVisible="{Binding CaloriesPerServing, Converter={StaticResource IsNotEmptyConverter}}"
                                       FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" Margin="0,0,12,0" />
                                <Label Text="{Binding IngredientCount, StringFormat='{0} ingredients'}" FontSize="12" TextColor="{StaticResource Gray500}" />
                            </FlexLayout>

                            <!-- Star: save / unsave this recipe to "My Saved".
                                 Emoji ⭐ renders via the system color font (OpenSans
                                 lacks ☆/★); dim = not saved, bright = saved. -->
                            <Label Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                   Text="&#x2B50;"
                                   FontSize="22"
                                   Opacity="{Binding IsSaved, Converter={StaticResource BoolToOpacity}}"
                                   VerticalOptions="Center"
                                   Padding="8,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=ToggleSaveRecipeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                    <Label Text="No recipes found" FontSize="16" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Saved Recipes List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding SavedRecipes}"
                        IsVisible="{Binding IsShowingSaved}"
                        SelectionMode="None">
            <CollectionView.Header>
                <BoxView HeightRequest="4" Color="Transparent" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SavedRecipe">
                    <Frame Style="{StaticResource CardFrame}" Margin="16,4" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=ViewSavedRecipeCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding RecipeName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="12">
                                <HorizontalStackLayout Spacing="4" IsVisible="{Binding PrepTime, Converter={StaticResource IsNotEmptyConverter}}">
                                    <Label Text="Prep:" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding PrepTime}" FontSize="12" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4" IsVisible="{Binding CookTime, Converter={StaticResource IsNotEmptyConverter}}">
                                    <Label Text="Cook:" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CookTime}" FontSize="12" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="12">
                                <Label Text="{Binding CategoryName}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Servings, StringFormat='Serving Size: {0}'}" FontSize="12" TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding CaloriesPerServing, StringFormat='{0} cal'}"
                                       FontSize="12" TextColor="{StaticResource Gray500}"
                                       IsVisible="{Binding CaloriesPerServing, Converter={StaticResource IsNotEmptyConverter}}" />
                            </HorizontalStackLayout>

                            <!-- Star: always filled here (these are saved); tap to remove. -->
                            <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                   Text="&#x2B50;"
                                   FontSize="22"
                                   VerticalOptions="Center"
                                   Padding="8,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeBrowseViewModel}}, Path=ToggleSavedRecipeStarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40" Spacing="8">
                    <Label Text="No favorites yet" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                    <Label Text="Browse recipes and tap the &#x2B50; to add them here" FontSize="14" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
