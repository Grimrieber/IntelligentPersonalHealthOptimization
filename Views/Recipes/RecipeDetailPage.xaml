<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             xmlns:recipe="clr-namespace:IntelligentPersonalHealthOptimization.Models.Recipe"
             x:Class="IntelligentPersonalHealthOptimization.Views.Recipes.RecipeDetailPage"
             x:DataType="vm:RecipeDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Recipe Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{Binding RecipeName}"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding CategoryName}"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray500}" />
                        <!-- Health tier badge -->
                        <Border IsVisible="{Binding ShowHealthBadge}"
                                BackgroundColor="{Binding HealthBadgeColor}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                Padding="9,3" VerticalOptions="Center">
                            <Label Text="{Binding HealthBadgeText}"
                                   FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Star: save / unsave. Dim = not saved, bright = saved. -->
                <Label Grid.Column="1"
                       Text="&#x2B50;"
                       FontSize="32"
                       Opacity="{Binding IsSaved, Converter={StaticResource BoolToOpacity}}"
                       VerticalOptions="Center"
                       Padding="6,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSaveCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Hero photo (Wikimedia Commons), when available -->
            <Border IsVisible="{Binding HasImage}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="200">
                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
            </Border>

            <!-- Time / Servings Cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Frame Style="{StaticResource CardFrame}" Grid.Column="0" Padding="10,8" IsVisible="{Binding HasPrepTime}">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Prep Time" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                        <Label Text="{Binding PrepTime}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Style="{StaticResource CardFrame}" Grid.Column="1" Padding="10,8" IsVisible="{Binding HasCookTime}">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Cook Time" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                        <Label Text="{Binding CookTime}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Style="{StaticResource CardFrame}" Grid.Column="2" Padding="10,8" IsVisible="{Binding HasRestTime}">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Rest Time" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                        <Label Text="{Binding RestTime}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Servings -->
            <Frame Style="{StaticResource CardFrame}" Padding="12,8">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Servings:" FontSize="14" TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                        <Label Text="{Binding Servings}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <!-- Provenance note, e.g. "Estimated (~5 servings)" or "Per serving (of 2)" -->
                    <Label Text="{Binding ServingSizeNote}"
                           IsVisible="{Binding ServingSizeNote, Converter={StaticResource IsNotEmptyConverter}}"
                           FontSize="11" FontAttributes="Italic"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- ===== INGREDIENTS ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Ingredients"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

                <BoxView HeightRequest="2" Color="{StaticResource Primary}" HorizontalOptions="Fill" />

                <!-- Using BindableLayout instead of nested CollectionView to avoid MAUI crash -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding IngredientGroups}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="recipe:IngredientGrouping">
                            <VerticalStackLayout Spacing="4" Padding="0,4">
                                <Label Text="{Binding GroupName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding GroupName, Converter={StaticResource IsNotEmptyConverter}}"
                                       TextColor="{StaticResource Gray600}"
                                       Margin="0,8,0,2" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="recipe:RecipeIngredient">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="8,4">
                                                <Label Text="&#x2022;" FontSize="14" TextColor="{StaticResource Primary}" VerticalOptions="Start" />
                                                <Label Grid.Column="1" Text="{Binding Description}" FontSize="14" LineBreakMode="WordWrap" VerticalOptions="Start" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===== DIRECTIONS ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Directions"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

                <BoxView HeightRequest="2" Color="{StaticResource Primary}" HorizontalOptions="Fill" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DirectionGroups}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="recipe:DirectionGrouping">
                            <VerticalStackLayout Spacing="4" Padding="0,4">
                                <Label Text="{Binding GroupName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding GroupName, Converter={StaticResource IsNotEmptyConverter}}"
                                       TextColor="{StaticResource Gray600}"
                                       Margin="0,8,0,2" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="recipe:RecipeDirection">
                                            <Grid ColumnDefinitions="36,*" Padding="4,6" ColumnSpacing="8">
                                                <Frame BackgroundColor="{StaticResource Primary}"
                                                       CornerRadius="14"
                                                       WidthRequest="28"
                                                       HeightRequest="28"
                                                       Padding="0"
                                                       HasShadow="False"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Start">
                                                    <Label Text="{Binding StepNumber}"
                                                           TextColor="White"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Frame>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Instruction}"
                                                       FontSize="14"
                                                       LineBreakMode="WordWrap"
                                                       VerticalOptions="Start" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===== NOTES ===== -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasNotes}">
                <Label Text="Notes"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                <BoxView HeightRequest="2" Color="{StaticResource Primary}" HorizontalOptions="Fill" />
                <Frame Style="{StaticResource CardFrame}" Padding="14">
                    <Label Text="{Binding Notes}" FontSize="14" LineBreakMode="WordWrap" />
                </Frame>
            </VerticalStackLayout>

            <!-- ===== NUTRITION FACTS ===== -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasNutrition}">
                <Label Text="Nutrition Facts"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                <BoxView HeightRequest="2" Color="{StaticResource Primary}" HorizontalOptions="Fill" />

                <!-- Serving scaler — step servings to portion the recipe to your macros -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,2"
                      IsVisible="{Binding HasNutrition}">
                    <Button Grid.Column="0" Text="&#x2212;"
                            Command="{Binding DecreaseServingsCommand}"
                            IsEnabled="{Binding CanDecreaseServings}"
                            WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                            FontSize="20" FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            TextColor="{StaticResource Primary}" />
                    <Label Grid.Column="1" Text="{Binding ScaleLabel}"
                           FontSize="14" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Button Grid.Column="2" Text="+"
                            Command="{Binding IncreaseServingsCommand}"
                            WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                            FontSize="20" FontAttributes="Bold"
                            BackgroundColor="{StaticResource Primary}" TextColor="White" />
                </Grid>

                <!-- Fits your goals: verdict vs the user's calorie/macro targets -->
                <Border IsVisible="{Binding ShowGoalFit}" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                        Padding="12" Margin="0,2,0,2">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#x1F3AF;" FontSize="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding GoalFitVerdict}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{Binding GoalFitColor}" />
                            <Label Text="{Binding GoalFitDetail}" FontSize="12"
                                   TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Macro split bar: protein / carbs / fat by calorie contribution -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasMacroBar}" Margin="0,2,0,6">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 7" HeightRequest="14"
                            HorizontalOptions="Fill">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProteinStar}" />
                                <ColumnDefinition Width="{Binding CarbsStar}" />
                                <ColumnDefinition Width="{Binding FatStar}" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#3B82F6" />
                            <BoxView Grid.Column="1" Color="#F59E0B" />
                            <BoxView Grid.Column="2" Color="#EF4444" />
                        </Grid>
                    </Border>
                    <FlexLayout Wrap="Wrap" JustifyContent="Center">
                        <HorizontalStackLayout Spacing="5" Margin="8,0" VerticalOptions="Center">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="2" Color="#3B82F6" VerticalOptions="Center" />
                            <Label Text="{Binding ProteinPct}" FontSize="12" TextColor="{StaticResource Gray500}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5" Margin="8,0" VerticalOptions="Center">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="2" Color="#F59E0B" VerticalOptions="Center" />
                            <Label Text="{Binding CarbsPct}" FontSize="12" TextColor="{StaticResource Gray500}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5" Margin="8,0" VerticalOptions="Center">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="2" Color="#EF4444" VerticalOptions="Center" />
                            <Label Text="{Binding FatPct}" FontSize="12" TextColor="{StaticResource Gray500}" />
                        </HorizontalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>

                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="Center">
                            <Label Text="Calories" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Calories}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Gray200}" />

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Protein" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Protein}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Carbs" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Carbs}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="3" Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Fat" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Fat}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Fiber" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Fiber}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="4" Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Sugar" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Sugar}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="4" Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Sodium" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Sodium}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="5" Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Saturated Fat" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding SaturatedFat}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="5" Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Cholesterol" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                            <Label Text="{Binding Cholesterol}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Log this recipe (at the chosen serving count) to today's nutrition -->
                <Button Text="&#x1F37D;  Log to Today"
                        Command="{Binding LogRecipeCommand}"
                        IsVisible="{Binding HasNutrition}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontAttributes="Bold" Margin="0,4,0,0" />

                <!-- Discoverable save action (beyond the header star) -->
                <Button Text="{Binding SaveButtonText}"
                        Command="{Binding ToggleSaveCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,4,0,0" />
            </VerticalStackLayout>

            <BoxView HeightRequest="20" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
