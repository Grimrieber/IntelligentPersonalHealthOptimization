<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             xmlns:controls="clr-namespace:IntelligentPersonalHealthOptimization.Controls"
             x:Class="IntelligentPersonalHealthOptimization.Views.Nutrition.NutritionDashboardPage"
             x:DataType="vm:NutritionDashboardViewModel"
             Title="Nutrition Coach">

    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Page Header -->
                <Label Text="Nutrition Coach"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <!-- Call-to-action: Nutrition Assessment not yet done -->
                <Frame Style="{StaticResource CardFrame}"
                       IsVisible="{Binding HasNutritionAssessment, Converter={StaticResource InverseBool}}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Nutrition Assessment"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="Complete a nutrition assessment to get personalized dietary recommendations based on your body composition, eating habits, and goals."
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Start Nutrition Assessment"
                                Command="{Binding StartNutritionAssessmentCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Call-to-action: Wellness Check-In not yet done -->
                <Frame Style="{StaticResource CardFrame}"
                       IsVisible="{Binding HasWellnessCheckIn, Converter={StaticResource InverseBool}}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Wellness Check-In"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="Take a quick check-in to help us personalize your nutrition experience and make sure you have the right support for your goals."
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Start Check-In"
                                Command="{Binding StartWellnessCheckInCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- TODAY: calories + macros combined (the daily glance) -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Today" FontSize="18" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Button Text="&#x1F4C8;  Trends"
                                        Command="{Binding ViewTrendsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="13" HeightRequest="36"
                                        VerticalOptions="Center" />
                                <Button Text="View Log"
                                        Command="{Binding ViewFoodLogCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="13" HeightRequest="36"
                                        VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Calorie ring: centre shows remaining (more actionable than consumed) -->
                        <Grid WidthRequest="180" HeightRequest="180" HorizontalOptions="Center">
                            <controls:ProgressRing Progress="{Binding CalorieProgress}"
                                                   RingColor="{StaticResource Primary}"
                                                   TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                   Thickness="16" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                <Label Text="{Binding CaloriesRemainingValue}"
                                       FontSize="36" FontAttributes="Bold" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                <Label Text="{Binding CaloriesRemainingCaption}"
                                       FontSize="13" HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding CalorieLabel}" FontSize="11" HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray400}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Macro mini-rings: Protein / Carbs / Fat -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                                <Grid WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                                    <controls:ProgressRing Progress="{Binding ProteinProgress}"
                                                           RingColor="#2196F3" Thickness="7"
                                                           TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                    <Label Text="P" FontSize="16" FontAttributes="Bold" TextColor="#2196F3"
                                           VerticalOptions="Center" HorizontalOptions="Center" />
                                </Grid>
                                <Label Text="Protein" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <Label Text="{Binding ProteinLabel}" FontSize="12" FontAttributes="Bold" TextColor="#2196F3" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                <Grid WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                                    <controls:ProgressRing Progress="{Binding CarbsProgress}"
                                                           RingColor="#FF9800" Thickness="7"
                                                           TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                    <Label Text="C" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"
                                           VerticalOptions="Center" HorizontalOptions="Center" />
                                </Grid>
                                <Label Text="Carbs" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <Label Text="{Binding CarbsLabel}" FontSize="12" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                <Grid WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                                    <controls:ProgressRing Progress="{Binding FatProgress}"
                                                           RingColor="#F44336" Thickness="7"
                                                           TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                    <Label Text="F" FontSize="16" FontAttributes="Bold" TextColor="#F44336"
                                           VerticalOptions="Center" HorizontalOptions="Center" />
                                </Grid>
                                <Label Text="Fat" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                                <Label Text="{Binding FatLabel}" FontSize="12" FontAttributes="Bold" TextColor="#F44336" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Water tracker -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="💧" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Text="Water" FontSize="13" TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding WaterLabel}" FontSize="15" FontAttributes="Bold" TextColor="#29B6F6" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="−"
                                    Command="{Binding RemoveWaterCommand}"
                                    FontSize="20" FontAttributes="Bold"
                                    WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                    VerticalOptions="Center" />
                            <Button Grid.Column="3" Text="+"
                                    Command="{Binding AddWaterCommand}"
                                    FontSize="20" FontAttributes="Bold"
                                    WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                                    BackgroundColor="#29B6F6" TextColor="White"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Weight & Progress -->
                <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding HasWeightGoal}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Your Progress" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Button Text="Log Weight"
                                    Command="{Binding LogProgressCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="13" HeightRequest="36"
                                    VerticalOptions="Center"
                                    Grid.Column="1" />
                        </Grid>

                        <!-- Current weight prominent -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding CurrentWeightDisplay}"
                                   FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="Current Weight" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Progress bar with % and days -->
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ProgressPercentText}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="{Binding DaysRemainingText}"
                                       FontSize="12" TextColor="{StaticResource Gray500}"
                                       Grid.Column="1" />
                            </Grid>
                            <ProgressBar Progress="{Binding WeightGoalProgress}"
                                         ProgressColor="{StaticResource Primary}"
                                         HeightRequest="10" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Text="{Binding StartWeightDisplay}"
                                       FontSize="11" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding TargetWeightDisplay}"
                                       FontSize="11" TextColor="{StaticResource Gray400}"
                                       HorizontalOptions="End" Grid.Column="1" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Weight changed since start -->
                        <Frame Padding="10,8" CornerRadius="8" HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light=#F0FFF4, Dark=#1A2E1A}"
                               BorderColor="{AppThemeBinding Light=#C6F6D5, Dark=#2D5A2D}"
                               IsVisible="{Binding HasWeightChange}">
                            <Label Text="{Binding WeightChangeText}"
                                   FontSize="13" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#276749, Dark=#9AE6B4}" />
                        </Frame>

                        <Label Text="{Binding AssessmentDateRange}"
                               FontSize="11" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Today's Planned Meals -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPlannedMeals}">
                    <Label Text="Today's Meals" Style="{StaticResource SectionHeader}" />
                    <Label Grid.Column="1" Text="{Binding PlannedTotalText}"
                           FontSize="12" TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPlannedMeals}"
                                     BindableLayout.ItemsSource="{Binding TodaysPlannedMeals}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlannedMealItem">
                            <Frame Margin="0,4" Padding="14,10" CornerRadius="12" HasShadow="False"
                                   BackgroundColor="{Binding CardColor}"
                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                  <!-- Thumbnail: emoji/accent tile with the dish photo
                                       on top (mirrors the Recipes-tab card). -->
                                  <Border Grid.Column="0" WidthRequest="56" HeightRequest="56"
                                          StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                          VerticalOptions="Start" Margin="0,2,0,0">
                                      <Grid WidthRequest="56" HeightRequest="56">
                                          <Border StrokeThickness="0" BackgroundColor="{Binding Accent}">
                                              <Label Text="{Binding Emoji}" FontSize="24"
                                                     HorizontalOptions="Center" VerticalOptions="Center" />
                                          </Border>
                                          <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                                                 WidthRequest="56" HeightRequest="56" />
                                      </Grid>
                                  </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <!-- Recipe name (tappable for recipe) + calories -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding RecipeName}" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionDashboardViewModel}}, Path=ViewPlannedMealCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="{Binding Calories}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" Grid.Column="1"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <!-- Meal type (also tappable) + health badge -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding MealTypeName}" FontSize="12"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource Gray500}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionDashboardViewModel}}, Path=ViewPlannedMealCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Border IsVisible="{Binding ShowHealthBadge}"
                                                BackgroundColor="{Binding HealthBadgeColor}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                Padding="7,2" VerticalOptions="Center">
                                            <Label Text="{Binding HealthBadgeText}"
                                                   FontSize="10" FontAttributes="Bold" TextColor="White" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <!-- Meal-prep badge: this meal repeats across the prep block -->
                                    <Border IsVisible="{Binding HasMealPrepNote}"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#EDE7F6, Dark=#311B92}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            HorizontalOptions="Start"
                                            Margin="0,4,0,0">
                                        <Label Text="{Binding MealPrepNote}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    </Border>
                                    <!-- Diet badge (e.g. "Vegan · Pea Protein" on plant-protein shakes) -->
                                    <Border IsVisible="{Binding HasDietBadge}"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            HorizontalOptions="Start"
                                            Margin="0,4,0,0">
                                        <Label Text="{Binding DietBadge}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1B5E20, Dark={StaticResource White}}" />
                                    </Border>
                                    <!-- Servings note -->
                                    <Label Text="{Binding ServingsNote}" FontSize="12" FontAttributes="Italic"
                                           TextColor="{StaticResource Primary}"
                                           IsVisible="{Binding HasServingsNote}" />
                                    <!-- Macros -->
                                    <Label Text="{Binding MacroSummary}" FontSize="11"
                                           TextColor="{StaticResource Gray400}"
                                           LineBreakMode="WordWrap"
                                           Margin="0,4,0,0" />
                                    <!-- Swap (equivalent-calorie replacement) + Log/Unlog buttons -->
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,4,0,0">
                                        <Button Text="Swap" FontSize="12" HeightRequest="32" Padding="12,0"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsSwappable}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionDashboardViewModel}}, Path=SwapPlannedMealCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="{Binding LogButtonText}" FontSize="12" HeightRequest="32" Padding="12,0"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalOptions="Center"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NutritionDashboardViewModel}}, Path=LogPlannedMealCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Text="Add Food"
                            Command="{Binding LogFoodCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14" />
                    <Button Grid.Column="1"
                            Text="Meal Plan"
                            Command="{Binding ViewMealPlanCommand}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="14" />
                </Grid>

                <!-- Slim status chips (done state): re-assess / re-check, low frequency -->
                <Frame Style="{StaticResource CardFrame}" Padding="12,10"
                       IsVisible="{Binding HasNutritionAssessment}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <BoxView Grid.Column="0" Color="#43A047" WidthRequest="4" CornerRadius="2" VerticalOptions="Fill" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Nutrition Assessment" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="{Binding LastAssessmentDate, StringFormat='Last assessed: {0}'}"
                                   FontSize="12" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Re-assess"
                                Command="{Binding StartNutritionAssessmentCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="12" HeightRequest="34" Padding="12,0"
                                VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrame}" Padding="12,10"
                       IsVisible="{Binding HasWellnessCheckIn}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <BoxView Grid.Column="0" Color="#1E88E5" WidthRequest="4" CornerRadius="2" VerticalOptions="Fill" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Wellness Check-In" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="{Binding LastWellnessCheckInDate, StringFormat='Last check-in: {0}'}"
                                   FontSize="12" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Re-check"
                                Command="{Binding StartWellnessCheckInCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="12" HeightRequest="34" Padding="12,0"
                                VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
