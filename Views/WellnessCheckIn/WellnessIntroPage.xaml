<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.WellnessCheckIn"
             x:Class="IntelligentPersonalHealthOptimization.Views.WellnessCheckIn.WellnessIntroPage"
             x:DataType="vm:WellnessIntroViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Wellness Check-In"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Label Text="Before we personalize your nutrition experience, we'd like to ask a few questions to make sure we set you up with the best approach for your goals."
                       FontSize="15"
                       TextColor="{StaticResource Gray600}"
                       LineHeight="1.4" />

                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                <Label Text="What to expect:"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="12">
                            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="14" WidthRequest="28" HeightRequest="28" Padding="0" HasShadow="False">
                                <Label Text="1" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="How You Feel About Food" FontSize="15" FontAttributes="Bold" />
                                <Label Text="A few questions about your relationship with food and eating" FontSize="13" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="14" WidthRequest="28" HeightRequest="28" Padding="0" HasShadow="False">
                                <Label Text="2" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Your Patterns and Habits" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Check any patterns that apply to you" FontSize="13" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="14" WidthRequest="28" HeightRequest="28" Padding="0" HasShadow="False">
                                <Label Text="3" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Your Personalized Results" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Recommendations tailored to your responses" FontSize="13" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}" Padding="16"
                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Your privacy matters" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Your responses are private and stored only on your device. They are never shared with anyone."
                               FontSize="13" TextColor="{StaticResource Gray600}" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="This takes about 3 minutes."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation -->
        <Button Grid.Row="2" Text="Let's Get Started"
                Command="{Binding GoNextCommand}"
                Style="{StaticResource PrimaryButton}"
                Margin="0,12,0,0" />

    </Grid>
</ContentPage>
