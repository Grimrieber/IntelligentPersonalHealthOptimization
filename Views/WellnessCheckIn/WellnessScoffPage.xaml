<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.WellnessCheckIn"
             x:Class="IntelligentPersonalHealthOptimization.Views.WellnessCheckIn.WellnessScoffPage"
             x:DataType="vm:WellnessScoffViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,8">

                <Label Text="How You Feel About Food"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Label Text="Please answer honestly — there are no right or wrong answers. This helps us personalize your experience."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       LineHeight="1.3" />

                <!-- SCOFF Questions -->
                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,80" RowDefinitions="Auto" Padding="0,4">
                            <Label Text="Have you ever made yourself throw up because you felt too full?"
                                   FontSize="14" LineHeight="1.3" VerticalOptions="Center" />
                            <Picker Grid.Column="1" ItemsSource="{Binding YesNoOptions}" Title="Select"
                                    SelectedIndex="{Binding ScoffSickIndex}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                        <Grid ColumnDefinitions="*,80" RowDefinitions="Auto" Padding="0,4">
                            <Label Text="Do you sometimes feel like you can't stop eating, even when you want to?"
                                   FontSize="14" LineHeight="1.3" VerticalOptions="Center" />
                            <Picker Grid.Column="1" ItemsSource="{Binding YesNoOptions}" Title="Select"
                                    SelectedIndex="{Binding ScoffControlIndex}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                        <Grid ColumnDefinitions="*,80" RowDefinitions="Auto" Padding="0,4">
                            <Label Text="Have you lost more than 14 pounds (6.5 kg) in the last 3 months without trying?"
                                   FontSize="14" LineHeight="1.3" VerticalOptions="Center" />
                            <Picker Grid.Column="1" ItemsSource="{Binding YesNoOptions}" Title="Select"
                                    SelectedIndex="{Binding ScoffWeightLossIndex}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                        <Grid ColumnDefinitions="*,80" RowDefinitions="Auto" Padding="0,4">
                            <Label Text="Do you feel you are overweight even when others tell you you're not?"
                                   FontSize="14" LineHeight="1.3" VerticalOptions="Center" />
                            <Picker Grid.Column="1" ItemsSource="{Binding YesNoOptions}" Title="Select"
                                    SelectedIndex="{Binding ScoffBodyImageIndex}" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                        <Grid ColumnDefinitions="*,80" RowDefinitions="Auto" Padding="0,4">
                            <Label Text="Do thoughts about food take up a large part of your day?"
                                   FontSize="14" LineHeight="1.3" VerticalOptions="Center" />
                            <Picker Grid.Column="1" ItemsSource="{Binding YesNoOptions}" Title="Select"
                                    SelectedIndex="{Binding ScoffFoodDominatesIndex}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Nutrition Context -->
                <Label Text="A few more questions about your habits"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="How many meals do you typically eat per day?" FontSize="14" />
                            <Picker ItemsSource="{Binding MealsPerDayOptions}"
                                    SelectedIndex="{Binding MealsPerDayIndex}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="How often do you weigh yourself?" FontSize="14" />
                            <Picker ItemsSource="{Binding WeighFrequencyOptions}"
                                    SelectedIndex="{Binding WeighFrequencyIndex}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="How do you feel after eating a large meal?" FontSize="14" />
                            <Picker ItemsSource="{Binding PostMealFeelingOptions}"
                                    SelectedIndex="{Binding PostMealFeelingIndex}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="How would you describe your relationship with food?" FontSize="14" />
                            <Picker ItemsSource="{Binding FoodRelationshipOptions}"
                                    SelectedIndex="{Binding FoodRelationshipIndex}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Do you avoid certain foods? If yes, why?" FontSize="14" />
                            <Picker ItemsSource="{Binding FoodAvoidanceOptions}"
                                    SelectedIndex="{Binding FoodAvoidanceIndex}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
            <Button Grid.Column="0" Text="Back"
                    Command="{Binding GoPreviousCommand}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" Text="Next"
                    Command="{Binding GoNextCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

    </Grid>
</ContentPage>
