<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="IntelligentPersonalHealthOptimization.Views.Workout.WorkoutDayPage"
             x:DataType="vm:WorkoutDayViewModel"
             Title="{Binding DayName}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding DayName}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Focus}" FontSize="16" TextColor="{StaticResource Gray500}" />

            <CollectionView ItemsSource="{Binding ExerciseSections}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseSection">
                        <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                            <!-- Tappable section header — toggles the body open/closed -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0"
                                       Text="{Binding ToggleIcon}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Column="1"
                                       Text="{Binding CategoryName}"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Column="2"
                                       Text="{Binding ExerciseCountSummary}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Exercises}"
                                            IsVisible="{Binding IsExpanded}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkoutExerciseDisplay">
                                        <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                            <VerticalStackLayout Spacing="8">
                                                <Label Text="{Binding ExerciseName}"
                                                       FontSize="17" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                                                <!-- Bundled anatomy-art demo: 2-frame animated GIF (start ↔ end) from everkinetic.
                                                     Offline, no network. Exercises without a bundled match show no image. -->
                                                <Image Source="{Binding ImageSource}"
                                                       Aspect="AspectFit"
                                                       HeightRequest="240"
                                                       HorizontalOptions="Center"
                                                       IsAnimationPlaying="True"
                                                       IsVisible="{Binding HasImage}" />

                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                    <VerticalStackLayout Grid.Column="0">
                                                        <Label Text="Sets x Reps" FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="{Binding SetsReps}" FontSize="14"
                                                               FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Tempo" FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="{Binding Tempo}" FontSize="14"
                                                               FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2">
                                                        <Label Text="Rest" FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="{Binding Rest}" FontSize="14"
                                                               FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <!-- Recommended weight (from working-max % calc) -->
                                                <Frame BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#332D1F}"
                                                       BorderColor="Transparent"
                                                       Padding="10,6"
                                                       CornerRadius="6"
                                                       HasShadow="False"
                                                       IsVisible="{Binding HasRecommendedWeight}">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="Try"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                               VerticalOptions="Center" />
                                                        <Label Text="{Binding RecommendedWeightDisplay}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Frame>

                                                <!-- Action row -->
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Grid.Column="0"
                                                            Text="How to perform"
                                                            Command="{Binding ToggleGuideCommand}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="13" HeightRequest="36" />
                                                    <Button Grid.Column="1"
                                                            Text="Log sets"
                                                            Command="{Binding ToggleLogCommand}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            FontSize="13" HeightRequest="36" />
                                                </Grid>

                                                <!-- Set logging table -->
                                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsLogExpanded}">
                                                    <Grid ColumnDefinitions="60,*,*" ColumnSpacing="8">
                                                        <Label Grid.Column="0" Text="Set" FontSize="11" TextColor="{StaticResource Gray500}" />
                                                        <Label Grid.Column="1" Text="Weight (kg)" FontSize="11" TextColor="{StaticResource Gray500}" />
                                                        <Label Grid.Column="2" Text="Reps" FontSize="11" TextColor="{StaticResource Gray500}" />
                                                    </Grid>
                                                    <CollectionView ItemsSource="{Binding SetLogs}">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SetLogEntry">
                                                                <Grid ColumnDefinitions="60,*,*" ColumnSpacing="8" Padding="0,2">
                                                                    <Label Grid.Column="0"
                                                                           Text="{Binding SetLabel}"
                                                                           FontSize="13"
                                                                           VerticalOptions="Center" />
                                                                    <Entry Grid.Column="1"
                                                                           Text="{Binding WeightKgText}"
                                                                           Placeholder="kg"
                                                                           Keyboard="Numeric" />
                                                                    <Entry Grid.Column="2"
                                                                           Text="{Binding RepsText}"
                                                                           Placeholder="reps"
                                                                           Keyboard="Numeric" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </CollectionView.ItemTemplate>
                                                    </CollectionView>
                                                </VerticalStackLayout>

                                                <!-- Expanded guide -->
                                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsGuideExpanded}">
                                                    <Label Text="Description"
                                                           FontSize="12" FontAttributes="Bold"
                                                           TextColor="{StaticResource Gray500}"
                                                           IsVisible="{Binding Description, Converter={StaticResource IsNotEmptyConverter}}" />
                                                    <Label Text="{Binding Description}"
                                                           FontSize="14"
                                                           LineHeight="1.4"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                           IsVisible="{Binding Description, Converter={StaticResource IsNotEmptyConverter}}" />

                                                    <Label Text="Form cues"
                                                           FontSize="12" FontAttributes="Bold"
                                                           TextColor="{StaticResource Gray500}"
                                                           IsVisible="{Binding FormCues, Converter={StaticResource IsNotEmptyConverter}}" />
                                                    <Label Text="{Binding FormCues}"
                                                           FontSize="14"
                                                           LineHeight="1.5"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                                           IsVisible="{Binding FormCues, Converter={StaticResource IsNotEmptyConverter}}" />

                                                    <Label Text="No detailed guide available for this exercise yet — tap 'Watch video' for a demonstration."
                                                           FontSize="12"
                                                           FontAttributes="Italic"
                                                           TextColor="{StaticResource Gray500}"
                                                           IsVisible="{Binding HasNoGuide}" />
                                                </VerticalStackLayout>

                                                <Label Text="{Binding Notes}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Primary}"
                                                       FontAttributes="Italic"
                                                       IsVisible="{Binding Notes, Converter={StaticResource IsNotEmptyConverter}}" />
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
