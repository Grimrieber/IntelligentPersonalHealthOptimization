<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             x:Class="IntelligentPersonalHealthOptimization.Views.Workout.WorkoutDayPage"
             x:DataType="vm:WorkoutDayViewModel"
             Title="{Binding DayName}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{Binding DayName}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Focus}" FontSize="16" TextColor="{StaticResource Gray500}" />

            <CollectionView ItemsSource="{Binding ExerciseSections}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseSection">
                        <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                            <Label Text="{Binding CategoryName}"
                                   Style="{StaticResource SectionHeader}"
                                   TextColor="{StaticResource Primary}" />

                            <CollectionView ItemsSource="{Binding Exercises}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkoutExerciseDisplay">
                                        <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="{Binding ExerciseName}"
                                                       FontSize="16" FontAttributes="Bold" />

                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                    <VerticalStackLayout Grid.Column="0">
                                                        <Label Text="Sets x Reps" FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="{Binding SetsReps}" FontSize="14"
                                                               FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Tempo" FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="{Binding Tempo}" FontSize="14"
                                                               FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2">
                                                        <Label Text="Rest" FontSize="10"
                                                               TextColor="{StaticResource Gray500}" />
                                                        <Label Text="{Binding Rest}" FontSize="14"
                                                               FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <Label Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray500}"
                                                       IsVisible="{Binding Description, Converter={StaticResource IsNotEmptyConverter}}" />

                                                <Label Text="{Binding FormCues}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray400}"
                                                       IsVisible="{Binding FormCues, Converter={StaticResource IsNotEmptyConverter}}" />

                                                <Label Text="{Binding Notes}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Primary}"
                                                       FontAttributes="Italic"
                                                       IsVisible="{Binding Notes, Converter={StaticResource IsNotEmptyConverter}}" />
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
