<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="IntelligentPersonalHealthOptimization.Views.Progress.ProgressPage"
             x:DataType="vm:ProgressViewModel"
             Title="Progress">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="Progress" FontSize="28" FontAttributes="Bold" />

                <!-- Weight Summary -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Frame Style="{StaticResource CardFrame}" Grid.Column="0">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Current Weight" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding LatestWeight}" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Style="{StaticResource CardFrame}" Grid.Column="1">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Change" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding WeightChange}" FontSize="22" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Weight Chart -->
                <Frame Style="{StaticResource CardFrame}"
                       IsVisible="{Binding WeightChart, Converter={StaticResource IsNotEmptyConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Weight Trend" Style="{StaticResource SectionHeader}" />
                        <micro:ChartView Chart="{Binding WeightChart}"
                                         HeightRequest="200" />
                    </VerticalStackLayout>
                </Frame>

                <!-- No Data State -->
                <Frame Style="{StaticResource CardFrame}"
                       IsVisible="{Binding HasData, Converter={StaticResource InverseBool}}">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="No progress data yet" FontSize="18" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Start logging your weight and measurements to track your progress."
                               FontSize="14" TextColor="{StaticResource Gray500}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

                <!-- History -->
                <Label Text="History" Style="{StaticResource SectionHeader}"
                       IsVisible="{Binding HasData}" />
                <CollectionView ItemsSource="{Binding History}"
                                IsVisible="{Binding HasData}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProgressHistoryItem">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Date}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding Weight}" Grid.Column="1"
                                               FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Grid>
                                    <Label Text="{Binding MeasurementSummary}"
                                           FontSize="12" TextColor="{StaticResource Gray500}"
                                           IsVisible="{Binding MeasurementSummary, Converter={StaticResource IsNotEmptyConverter}}" />
                                    <Label Text="{Binding Notes}"
                                           FontSize="12" TextColor="{StaticResource Gray400}"
                                           IsVisible="{Binding Notes, Converter={StaticResource IsNotEmptyConverter}}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Add Button -->
        <Button Text="+ Log Progress"
                Grid.Row="1"
                Command="{Binding AddProgressCommand}"
                Style="{StaticResource PrimaryButton}"
                Margin="20,8,20,20" />
    </Grid>
</ContentPage>
