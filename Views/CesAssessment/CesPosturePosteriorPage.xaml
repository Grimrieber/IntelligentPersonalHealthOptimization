<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.CesAssessment"
             x:Class="IntelligentPersonalHealthOptimization.Views.CesAssessment.CesPosturePosteriorPage"
             x:DataType="vm:CesPosturePosteriorViewModel"
             Shell.NavBarIsVisible="False"
             Title="Posture — Back View">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Progress -->
        <VerticalStackLayout Grid.Row="0" Padding="24,16,24,8" Spacing="4">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8" Spacing="16">

                <Label Text="Stand Naturally — Back View"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Frame Style="{StaticResource CardFrame}" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="How to perform:" FontSize="14" FontAttributes="Bold" />
                        <Label FontSize="13" LineHeight="1.4" TextColor="{StaticResource Gray600}">
                            <Label.Text>1. Have someone observe you from behind (you can't do this view alone).

2. Same natural stance as before.

3. They should look for: Do your shoulder blades stick out from your back? Is your spine straight or does it curve to one side? Do your heels tilt inward?</Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Rate what you observe:" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="2">

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Scapular winging" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding PostureSeverityOptions}" SelectedIndex="{Binding ScapularWinging}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Spinal deviation (lateral curve)" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding PostureSeverityOptions}" SelectedIndex="{Binding SpinalDeviation}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Calcaneal eversion (heel tilts inward)" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding PostureSeverityOptions}" SelectedIndex="{Binding CalcanealEversion}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation -->
        <Grid Grid.Row="2" Padding="24,12" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Back"
                    Command="{Binding GoPreviousCommand}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1"
                    Text="Next"
                    Command="{Binding GoNextCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

    </Grid>
</ContentPage>
