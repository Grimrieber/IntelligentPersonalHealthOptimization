<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.CesAssessment"
             x:Class="IntelligentPersonalHealthOptimization.Views.CesAssessment.CesIntroPage"
             x:DataType="vm:CesIntroViewModel"
             Shell.NavBarIsVisible="False"
             Title="CES Assessment">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Progress -->
        <VerticalStackLayout Grid.Row="0" Padding="24,16,24,8" Spacing="4">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8" Spacing="16">

                <Label Text="Corrective Exercise Strategy"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Label Text="Welcome to your movement assessment! This evidence-based screen will identify muscle imbalances and movement compensations so we can build a targeted corrective program."
                       FontSize="15"
                       LineHeight="1.4"
                       TextColor="{StaticResource Gray600}" />

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="What We'll Assess" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />

                        <Label Text="1. Static Posture — Front View" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="2. Static Posture — Side View" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="3. Static Posture — Back View" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="4. Overhead Squat" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="5. Single-Leg Squat" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="6. Push &amp; Pull Assessment" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="7. Results &amp; Program" FontSize="14" TextColor="{StaticResource Gray600}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Before You Start" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Label Text="You'll need a mirror or a partner to help observe your posture and movements. Wear comfortable clothing that allows you to see your body alignment."
                               FontSize="14"
                               LineHeight="1.3"
                               TextColor="{StaticResource Gray600}" />
                        <Label Text="Takes about 5-7 minutes."
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Privacy" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Label Text="Your assessment data is stored locally on your device and used only to generate your personalized corrective exercise program. It is never shared with third parties."
                               FontSize="13"
                               LineHeight="1.3"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation -->
        <Grid Grid.Row="2" Padding="24,12" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Text="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" Text="Begin Assessment"
                    Command="{Binding GoNextCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

    </Grid>
</ContentPage>
