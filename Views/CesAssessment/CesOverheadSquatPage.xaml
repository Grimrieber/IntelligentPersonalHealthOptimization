<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.CesAssessment"
             x:Class="IntelligentPersonalHealthOptimization.Views.CesAssessment.CesOverheadSquatPage"
             x:DataType="vm:CesOverheadSquatViewModel"
             Shell.NavBarIsVisible="False"
             Title="Overhead Squat">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Progress -->
        <VerticalStackLayout Grid.Row="0" Padding="24,16,24,8" Spacing="4">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="End" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,8" Spacing="16">

                <Label Text="Overhead Squat Assessment"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Frame Style="{StaticResource CardFrame}" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="How to perform:" FontSize="14" FontAttributes="Bold" />
                        <Label FontSize="13" LineHeight="1.4" TextColor="{StaticResource Gray600}">
                            <Label.Text>1. Stand with feet shoulder-width apart, toes pointing straight ahead.

2. Raise both arms straight overhead, elbows locked, like you're reaching for the ceiling.

3. Keeping your arms up and feet flat on the floor, squat down as low as comfortable — like sitting into an invisible chair.

4. Stand back up. Repeat 5 times.

5. Have someone watch from the FRONT and SIDE, or film yourself with your phone. Rate what you see below.</Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Rate each observation:" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="2">

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Feet turn out" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding FeetTurnOut}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Feet flatten" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding FeetFlatten}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Knees cave inward" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding KneesValgus}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Excessive forward lean" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding ForwardLean}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Low back arches" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding LowBackArch}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Low back rounds" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding LowBackRound}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Heels rise" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding HeelsRise}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Arms fall forward" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding ArmsFallForward}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,140" Padding="0,4">
                            <Label Text="Asymmetric shift" FontSize="14" VerticalOptions="Center" LineHeight="1.3" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MovementSeverityOptions}" SelectedIndex="{Binding AsymmetricShift}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation -->
        <Grid Grid.Row="2" Padding="24,12" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Back"
                    Command="{Binding GoPreviousCommand}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1"
                    Text="Next"
                    Command="{Binding GoNextCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

    </Grid>
</ContentPage>
