<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.NutritionAssessment"
             xmlns:enums="clr-namespace:IntelligentPersonalHealthOptimization.Models.Enums"
             xmlns:models="clr-namespace:IntelligentPersonalHealthOptimization.Models"
             x:Class="IntelligentPersonalHealthOptimization.Views.NutritionAssessment.BehavioralReadinessPage"
             x:DataType="vm:BehavioralReadinessViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Motivation &amp; Barriers"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Understanding what drives you and what gets in the way helps us build a plan you can actually stick with."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Motivations -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="What motivates you?" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Select the reasons that drive your desire to improve nutrition."
                               FontSize="13" TextColor="{StaticResource Gray500}" />

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding MotivationChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ToggleChip">
                                    <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource Primary}" StrokeThickness="1"
                                            BackgroundColor="Transparent" Padding="14,9" Margin="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BehavioralReadinessViewModel}}, Path=ToggleMotivationChipCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Label}" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Challenges -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Current Challenges" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Select any barriers that make it hard to eat well consistently."
                               FontSize="13" TextColor="{StaticResource Gray500}" />

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding ChallengeChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ToggleChip">
                                    <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource Primary}" StrokeThickness="1"
                                            BackgroundColor="Transparent" Padding="14,9" Margin="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BehavioralReadinessViewModel}}, Path=ToggleChallengeChipCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Label}" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Confidence Level -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Confidence Level" FontSize="16" FontAttributes="Bold" />
                        <Label Text="How confident are you that you can make lasting nutritional changes?"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <Label Text="{Binding ConfidenceDisplay}"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="0" FontSize="12" TextColor="{StaticResource Gray500}" Grid.Column="0" />
                            <Slider Minimum="0" Maximum="10"
                                    Value="{Binding ConfidenceLevel}"
                                    MinimumTrackColor="{StaticResource Primary}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    Grid.Column="1" />
                            <Label Text="10" FontSize="12" TextColor="{StaticResource Gray500}" Grid.Column="2" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*">
                            <Label Text="Not confident" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Start" Grid.Column="0" />
                            <Label Text="Somewhat" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" Grid.Column="1" />
                            <Label Text="Very confident" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="End" Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
