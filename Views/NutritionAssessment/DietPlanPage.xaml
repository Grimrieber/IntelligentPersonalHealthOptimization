<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.NutritionAssessment"
             xmlns:enums="clr-namespace:IntelligentPersonalHealthOptimization.Models.Enums"
             x:Class="IntelligentPersonalHealthOptimization.Views.NutritionAssessment.DietPlanPage"
             x:DataType="vm:DietPlanViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Diet Plan &amp; Preferences"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Select your preferred diet type and any dietary restrictions. This will customize your macro targets and meal recommendations."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Diet Type -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Diet Type" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Choose the eating approach that best fits your lifestyle."
                               FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                Padding="12,4">
                            <Picker Title="Select Diet"
                                    ItemsSource="{Binding DietTypeOptions}"
                                    SelectedItem="{Binding SelectedDietType}"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumToString}}" />
                        </Border>
                    </VerticalStackLayout>
                </Frame>

                <!-- Meals Per Day -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Meals Per Day" FontSize="16" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="-"
                                    Command="{Binding DecrementMealsCommand}"
                                    WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    Grid.Column="0" />
                            <Label Text="{Binding MealsPerDayDisplay}"
                                   FontSize="20" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   Grid.Column="1" />
                            <Button Text="+"
                                    Command="{Binding IncrementMealsCommand}"
                                    WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Protein Shakes -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Protein Shakes" FontSize="16" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding UsesProteinShakes}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>
                        <Label Text="Do you supplement with protein shakes throughout the day?"
                               FontSize="13" TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout Spacing="12" IsVisible="{Binding UsesProteinShakes}">
                            <Label Text="Shakes per day" FontSize="14" FontAttributes="Bold" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Button Text="-"
                                        Command="{Binding DecrementShakesCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Grid.Column="0" />
                                <Label Text="{Binding ShakesPerDayDisplay}"
                                       FontSize="20" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="1" />
                                <Button Text="+"
                                        Command="{Binding IncrementShakesCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Grid.Column="2" />
                            </Grid>

                            <Label Text="Protein per shake" FontSize="14" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Button Text="-"
                                        Command="{Binding DecrementProteinPerShakeCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Grid.Column="0" />
                                <Label Text="{Binding ProteinPerShakeDisplay}"
                                       FontSize="20" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="1" />
                                <Button Text="+"
                                        Command="{Binding IncrementProteinPerShakeCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Grid.Column="2" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Meal Prep -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Meal Prep" FontSize="16" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding MealPrepMode}"
                                    OnColor="{StaticResource Primary}" />
                        </Grid>
                        <Label Text="Batch-cook a few recipes and repeat them, instead of a different meal every day."
                               FontSize="13" TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout Spacing="12" IsVisible="{Binding MealPrepMode}">
                            <Label Text="How often you cook" FontSize="14" FontAttributes="Bold" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Button Text="-"
                                        Command="{Binding DecrementMealPrepDaysCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Grid.Column="0" />
                                <Label Text="{Binding MealPrepDaysDisplay}"
                                       FontSize="20" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       Grid.Column="1" />
                                <Button Text="+"
                                        Command="{Binding IncrementMealPrepDaysCommand}"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Grid.Column="2" />
                            </Grid>
                            <Label Text="Each recipe covers this many days before you cook something new."
                                   FontSize="12" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Daily Water Goal -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Water Goal" FontSize="16" FontAttributes="Bold" />
                        <Label Text="How many glasses of water do you aim to drink per day?"
                               FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Text="-"
                                    Command="{Binding DecrementWaterCommand}"
                                    WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    Grid.Column="0" />
                            <Label Text="{Binding WaterGlassesDisplay}"
                                   FontSize="20" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   Grid.Column="1" />
                            <Button Text="+"
                                    Command="{Binding IncrementWaterCommand}"
                                    WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                    Grid.Column="2" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Food Allergies -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Food Allergies" FontSize="16" FontAttributes="Bold" />

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding SelectedAllergies}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="enums:FoodAllergy">
                                    <Border StrokeShape="RoundRectangle 16"
                                            Stroke="{StaticResource Primary}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                                            Padding="12,6" Margin="4">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding ., Converter={StaticResource EnumToString}}" FontSize="13" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label Text="x" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                                   TextColor="{StaticResource Gray500}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DietPlanViewModel}}, Path=RemoveAllergyCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Button Text="+ Add Allergy"
                                Command="{Binding AddAllergyCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="14" HeightRequest="40" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Foods to Avoid -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Foods to Avoid" FontSize="16" FontAttributes="Bold" />
                        <Label Text="Select any foods you prefer not to eat."
                               FontSize="13" TextColor="{StaticResource Gray500}" />

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding FoodsToAvoid}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 16"
                                            Stroke="{StaticResource Primary}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                                            Padding="12,6" Margin="4">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding .}" FontSize="13" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label Text="x" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                                   TextColor="{StaticResource Gray500}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DietPlanViewModel}}, Path=RemoveFoodToAvoidCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Button Text="+ Add Food to Avoid"
                                Command="{Binding AddFoodToAvoidCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="14" HeightRequest="40" />
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
