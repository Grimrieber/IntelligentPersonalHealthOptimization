<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.NutritionAssessment"
             x:Class="IntelligentPersonalHealthOptimization.Views.NutritionAssessment.FoodFrequencyPage"
             x:DataType="vm:FoodFrequencyViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,8">

                <Label Text="Food Frequency"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="How often do you consume the following foods? Select the frequency for each item."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Category Groups -->
                <VerticalStackLayout Spacing="16"
                                     BindableLayout.ItemsSource="{Binding CategoryGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FFQCategoryGroup">
                            <Frame Style="{StaticResource CardFrame}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding CategoryName}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                                    <VerticalStackLayout Spacing="10"
                                                         BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FFQItemViewModel">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding FoodName}" FontSize="14" FontAttributes="Bold" />
                                                    <Picker Title="Frequency"
                                                            ItemsSource="{Binding FrequencyOptions}"
                                                            SelectedItem="{Binding SelectedFrequency}" />
                                                    <BoxView HeightRequest="1"
                                                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                             Margin="0,4" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
