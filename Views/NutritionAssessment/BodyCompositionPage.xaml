<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels.NutritionAssessment"
             xmlns:converters="clr-namespace:IntelligentPersonalHealthOptimization.Converters"
             x:Class="IntelligentPersonalHealthOptimization.Views.NutritionAssessment.BodyCompositionPage"
             x:DataType="vm:BodyCompositionViewModel"
             Title="{Binding StepTitle}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Segmented cm/in toggle: highlight the active unit. -->
        <converters:BoolToColorConverter x:Key="CmActiveBg" TrueColor="{StaticResource Primary}" FalseColor="Transparent" />
        <converters:BoolToColorConverter x:Key="InActiveBg" TrueColor="Transparent" FalseColor="{StaticResource Primary}" />
        <converters:BoolToColorConverter x:Key="CmActiveText" TrueColor="White" FalseColor="{StaticResource Primary}" />
        <converters:BoolToColorConverter x:Key="InActiveText" TrueColor="{StaticResource Primary}" FalseColor="White" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,16">

        <!-- Progress bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <ProgressBar Progress="{Binding ProgressPercentage}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StepIndicator}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,8">

                <Label Text="Body Composition"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label Text="Take circumference measurements using a tape measure. Keep the tape taut and level. All measurements on the right side of the body."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

                <!-- Circumference Measurements -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="{Binding UnitTitle}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                            <!-- cm / in segmented toggle -->
                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0"
                                    HorizontalOptions="End">
                                <Grid ColumnDefinitions="Auto,Auto">
                                    <Button Text="cm"
                                            Command="{Binding SetUnitCommand}"
                                            CommandParameter="cm"
                                            BackgroundColor="{Binding UnitIsCm, Converter={StaticResource CmActiveBg}}"
                                            TextColor="{Binding UnitIsCm, Converter={StaticResource CmActiveText}}"
                                            CornerRadius="0"
                                            Padding="14,4"
                                            HeightRequest="36"
                                            FontSize="13" />
                                    <Button Grid.Column="1"
                                            Text="in"
                                            Command="{Binding SetUnitCommand}"
                                            CommandParameter="in"
                                            BackgroundColor="{Binding UnitIsCm, Converter={StaticResource InActiveBg}}"
                                            TextColor="{Binding UnitIsCm, Converter={StaticResource InActiveText}}"
                                            CornerRadius="0"
                                            Padding="14,4"
                                            HeightRequest="36"
                                            FontSize="13" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,120" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Text="Neck (across Adam's apple)" VerticalOptions="Center" FontSize="13" Grid.Row="0" />
                            <Entry Text="{Binding NeckText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="0" Grid.Column="1" />

                            <Label Text="Chest (across nipple line)" VerticalOptions="Center" FontSize="13" Grid.Row="1" />
                            <Entry Text="{Binding ChestText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="1" Grid.Column="1" />

                            <Label Text="Waist (narrowest point)" VerticalOptions="Center" FontSize="13" Grid.Row="2" />
                            <Entry Text="{Binding WaistText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="2" Grid.Column="1" />

                            <Label Text="Hips (widest point)" VerticalOptions="Center" FontSize="13" Grid.Row="3" />
                            <Entry Text="{Binding HipsText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="3" Grid.Column="1" />

                            <Label Text="Thigh (10 inches above patella)" VerticalOptions="Center" FontSize="13" Grid.Row="4" />
                            <Entry Text="{Binding ThighText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="4" Grid.Column="1" />

                            <Label Text="Calf (maximal circumference)" VerticalOptions="Center" FontSize="13" Grid.Row="5" />
                            <Entry Text="{Binding CalfText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="5" Grid.Column="1" />

                            <Label Text="Bicep (arm extended, maximal)" VerticalOptions="Center" FontSize="13" Grid.Row="6" />
                            <Entry Text="{Binding BicepText}" Keyboard="Numeric" Placeholder="{Binding UnitLabel}" Grid.Row="6" Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Body fat will be estimated from your waist, hips, and neck measurements using the US Navy formula."
                       FontSize="12"
                       TextColor="{StaticResource Gray500}"
                       FontAttributes="Italic" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="0,16,0,0">
            <Button Text="Back"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="0" />
            <Button Text="Next"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="1" />
        </Grid>

    </Grid>
</ContentPage>
