<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IntelligentPersonalHealthOptimization.ViewModels"
             xmlns:controls="clr-namespace:IntelligentPersonalHealthOptimization.Controls"
             x:Class="IntelligentPersonalHealthOptimization.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Greeting + Streak -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Greeting}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                       VerticalOptions="Center" />
                <Frame Grid.Column="1"
                       BackgroundColor="{StaticResource Primary}"
                       Padding="12,8"
                       CornerRadius="16"
                       HasShadow="False"
                       VerticalOptions="Center">
                    <Label Text="{Binding StreakText}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="White" />
                </Frame>
            </Grid>

            <!-- Quick Stats Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Frame Style="{StaticResource CardFrame}" Grid.Column="0" Padding="12,8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Weight" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentWeight}" FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Style="{StaticResource CardFrame}" Grid.Column="1" Padding="12,8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Completed" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                        <Label Text="{Binding WorkoutsCompletedText}" FontSize="18" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Style="{StaticResource CardFrame}" Grid.Column="2" Padding="12,8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Missed" FontSize="11" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                        <Label Text="{Binding WorkoutsMissedText}" FontSize="18" FontAttributes="Bold" TextColor="#F44336" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Today's Workout Card -->
            <Frame Style="{StaticResource CardFrame}" BorderColor="{StaticResource Primary}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="Today's Workout"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           Grid.Row="0" Grid.Column="0" />
                    <Label Text="{Binding LastAssessmentScore}"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}"
                           Grid.Row="0" Grid.Column="1" />
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,4,0,0">
                        <Label Text="{Binding TodaysWorkoutName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="{Binding TodaysWorkoutDetails}"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                    <Button Grid.Row="1" Grid.Column="1"
                            Text="Start"
                            Command="{Binding StartTodaysWorkoutCommand}"
                            IsVisible="{Binding HasTodaysWorkout}"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="80"
                            HeightRequest="40"
                            FontSize="14"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Nutrition Summary Card -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding HasNutritionData}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Today's Nutrition" Style="{StaticResource SectionHeader}" />
                        <Label Text="Log Food"
                               TextColor="{StaticResource Primary}"
                               FontSize="13"
                               FontAttributes="Bold"
                               Grid.Column="1"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogFoodCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Calorie ring: centre shows remaining (more actionable) -->
                    <Grid WidthRequest="160" HeightRequest="160" HorizontalOptions="Center" Margin="0,4">
                        <controls:ProgressRing Progress="{Binding CaloriesProgress}"
                                               RingColor="{StaticResource Primary}"
                                               TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                               Thickness="14" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                            <Label Text="{Binding CaloriesRemainingValue}"
                                   FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="{Binding CaloriesRemainingCaption}" FontSize="12" HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding CaloriesText}" FontSize="10" HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Macro mini-rings: Protein / Carbs / Fat -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Grid WidthRequest="62" HeightRequest="62" HorizontalOptions="Center">
                                <controls:ProgressRing Progress="{Binding ProteinProgress}" RingColor="#2196F3" Thickness="6"
                                                       TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                <Label Text="P" FontSize="15" FontAttributes="Bold" TextColor="#2196F3"
                                       VerticalOptions="Center" HorizontalOptions="Center" />
                            </Grid>
                            <Label FontSize="11" FontAttributes="Bold" TextColor="#2196F3" HorizontalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}g">
                                        <Binding Path="ProteinConsumed" />
                                        <Binding Path="ProteinTarget" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Grid WidthRequest="62" HeightRequest="62" HorizontalOptions="Center">
                                <controls:ProgressRing Progress="{Binding CarbsProgress}" RingColor="#FF9800" Thickness="6"
                                                       TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                <Label Text="C" FontSize="15" FontAttributes="Bold" TextColor="#FF9800"
                                       VerticalOptions="Center" HorizontalOptions="Center" />
                            </Grid>
                            <Label FontSize="11" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}g">
                                        <Binding Path="CarbsConsumed" />
                                        <Binding Path="CarbsTarget" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Grid WidthRequest="62" HeightRequest="62" HorizontalOptions="Center">
                                <controls:ProgressRing Progress="{Binding FatProgress}" RingColor="#F44336" Thickness="6"
                                                       TrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                                <Label Text="F" FontSize="15" FontAttributes="Bold" TextColor="#F44336"
                                       VerticalOptions="Center" HorizontalOptions="Center" />
                            </Grid>
                            <Label FontSize="11" FontAttributes="Bold" TextColor="#F44336" HorizontalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}/{1}g">
                                        <Binding Path="FatConsumed" />
                                        <Binding Path="FatTarget" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- ===== UP NEXT MEAL ===== -->
            <Frame Style="{StaticResource CardFrame}" Padding="0" IsVisible="{Binding HasUpNextMeal}">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewUpNextCommand}" />
                </Frame.GestureRecognizers>
                <Grid RowDefinitions="130,Auto">
                    <!-- Hero photo (or emoji tile) -->
                    <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 12,12,0,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                        <Grid>
                            <Label Text="{Binding UpNextEmoji}" FontSize="48"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image Source="{Binding UpNextImageUrl}" Aspect="AspectFill"
                                   IsVisible="{Binding HasUpNextImage}" />
                        </Grid>
                    </Border>
                    <!-- "UP NEXT · LUNCH" ribbon -->
                    <Border Grid.Row="0" VerticalOptions="Start" HorizontalOptions="Start" Margin="10"
                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="#CC5E5CE6" Padding="8,3">
                        <Label FontSize="10" FontAttributes="Bold" TextColor="White">
                            <Label.Text>
                                <MultiBinding StringFormat="{}UP NEXT · {0}">
                                    <Binding Path="UpNextMealTypeText" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </Border>

                    <Grid Grid.Row="1" Padding="14,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding UpNextName}"
                               FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding UpNextCalories}"
                               FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Log it"
                                Command="{Binding LogUpNextCommand}"
                                BackgroundColor="{StaticResource Primary}" TextColor="White"
                                FontAttributes="Bold" HeightRequest="40" Margin="0,8,0,0" />
                    </Grid>
                </Grid>
            </Frame>

            <!-- Active Goals Card -->
            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding HasActiveGoals}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Active Goals" Style="{StaticResource SectionHeader}" />
                        <Label Text="View All"
                               TextColor="{StaticResource Primary}"
                               FontSize="13"
                               FontAttributes="Bold"
                               Grid.Column="1"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewGoalsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ActiveGoals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:GoalSummaryItem">
                                <Grid ColumnDefinitions="*,50" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                    <Label Text="{Binding Title}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           Grid.Row="0" Grid.Column="0" />
                                    <Label Text="{Binding ProgressText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="End"
                                           Grid.Row="0" Grid.Column="1" />
                                    <ProgressBar Progress="{Binding ProgressBarValue}"
                                                 ProgressColor="{StaticResource Primary}"
                                                 Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Active Program Card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Active Program" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding ActiveProgramName}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding ActiveProgramPhase}" FontSize="13" TextColor="{StaticResource Gray500}" />
                    <Button Text="View Workout"
                            Command="{Binding ViewWorkoutCommand}"
                            IsVisible="{Binding HasActiveProgram}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="14"
                            HeightRequest="40"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Actions -->
            <Label Text="Quick Actions" Style="{StaticResource SectionHeader}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Button Text="Log Food"
                        Command="{Binding LogFoodCommand}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14"
                        HeightRequest="44"
                        Grid.Column="0" />
                <Button Text="Log Progress"
                        Command="{Binding LogProgressCommand}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14"
                        HeightRequest="44"
                        Grid.Column="1" />
                <Button Text="View Goals"
                        Command="{Binding ViewGoalsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14"
                        HeightRequest="44"
                        Grid.Column="2" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
